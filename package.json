{
  "name": "scope-shield",
  "version": "0.1.0",
  "description": "Chrome extension that detects scope creep and generates change orders for freelancers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "chrome-extension",
    "freelance",
    "scope-creep",
    "change-order"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.268",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^6.0.3",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^2.1.8"
  }
}
